{
  "name": "@catronomix/opencode-notepad",
  "version": "0.1.4",
  "description": "Per-chat scratchpad overlay for opencode: insert, save, load, format and /btw without touching the chat transcript",
  "license": "MIT",
  "author": "catronomix",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catronomix/opencode-notepad.git"
  },
  "homepage": "https://github.com/catronomix/opencode-notepad#readme",
  "bugs": {
    "url": "https://github.com/catronomix/opencode-notepad/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "scratchpad",
    "note"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "release-check": "node scripts/release-check.mjs",
    "prepack": "node scripts/release-check.mjs"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.3.2",
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.3.2",
    "@opencode/theme": "^2.3.2",
    "@opentui/core": "^0.9.7",
    "@opentui/solid": "^0.9.7",
    "@types/node": "^26.6.6",
    "solid-js": "^1.9.20",
    "typescript": "^5.9.3"
  }
}
